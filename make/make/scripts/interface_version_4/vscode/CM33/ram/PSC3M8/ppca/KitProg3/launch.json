        {
            "name": "Launch RAM PSOC C3 P8 &&_MTB_RECIPE__TARGET_PROCESSOR_NAME&& (KitProg3_MiniProg4)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "&&_MTB_RECIPE__ELF_FILE&&",
            "servertype": "openocd",
            "debuggerArgs": ["-l", "15"],
            "searchDir": [
                "${workspaceFolder}",
                "${config:modustoolbox.toolsPath}/&&_MTB_RECIPE__OPENOCD_SCRIPTS_DIR_RELATIVE&&/"
            ],
            "openOCDPreConfigLaunchCommands": [
                "gdb_breakpoint_override hard"
            ],
            "configFiles": [
                "openocd.tcl"
            ],
            "overrideLaunchCommands": [
                "set mem inaccessible-by-default off",
                "-enable-pretty-printing",
                "set remotetimeout 15"
            ],
            "overrideRestartCommands": [
                "flushregs"
            ],
            "numberOfProcessors": &&_MTB_RECIPE__PROCESSOR_COUNT&&,
            "targetProcessor": &&_MTB_RECIPE__TARGET_PROCESSOR_NUMBER&&,
            // svdFile is optional, it can be very large.
            "svdFile": "&&_MTB_RECIPE__SVD_FILE_NAME&&",
            "breakAfterReset": true,
            //"runToEntryPoint": "main",    // Specifies application entry point name where program will halt
            "preLaunchTask": "Build",        // Set this to run a task from tasks.json
                                                                    // before starting a debug session
            "showDevDebugOutput": "none",
            "presentation": {
                "hidden": false,
                "group": "&&_PRJ_NAME&&"
            },
            "liveWatch": {
                "enabled": true
            }
        },
        // When using 'attach', make sure your program is running on the board and that your executable matches
        // the image in the chip exactly, or else strange things can happen with breakpoint, variables, etc.
        {
            "name": "Attach RAM PSOC C3 P8 &&_MTB_RECIPE__TARGET_PROCESSOR_NAME&& (KitProg3_MiniProg4)",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "&&_MTB_RECIPE__ELF_FILE&&",
            "servertype": "openocd",
            "searchDir": [
                "${workspaceFolder}",
                "${config:modustoolbox.toolsPath}/&&_MTB_RECIPE__OPENOCD_SCRIPTS_DIR_RELATIVE&&/"
            ],
            "openOCDPreConfigLaunchCommands": [
                "gdb_breakpoint_override hard",
                "set ENABLE_ACQUIRE 0"
            ],
            "configFiles": [
                "openocd.tcl"
            ],
            "overrideAttachCommands": [
                "set mem inaccessible-by-default off",
                "-enable-pretty-printing",
                "set remotetimeout 15",
                "monitor halt"
            ],
            "overrideRestartCommands": [
                "flushregs"
            ],
            "numberOfProcessors": &&_MTB_RECIPE__PROCESSOR_COUNT&&,
            "targetProcessor": &&_MTB_RECIPE__TARGET_PROCESSOR_NUMBER&&,
            // svdFile is optional, it can be very large.
            "svdFile": "&&_MTB_RECIPE__SVD_FILE_NAME&&",
            "breakAfterReset": true,
            "runToEntryPoint": "main",//PSC3 Only//
            "showDevDebugOutput": "none",
            "presentation": {
                "hidden": false,
                "group": "&&_PRJ_NAME&&"
            },
            "liveWatch": {
                "enabled": true
            }
        }