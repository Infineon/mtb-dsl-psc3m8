    <ParamString id="pwmSS3Fill" name="pwmSS3_fill" group="Internal" default="`${(pwmSS3 eq CY_ALLOCATE_PERIPHERAL_TO_CPU0) ? ocean : berry}`" visible="false" editable="false" desc="" />

    <ParamChoice id="hwfilt3p3zSS0"
