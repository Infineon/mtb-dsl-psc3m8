                 group="PPCA Configuration"
                 visible="true"
                 editable="true"
                 desc="DCSG Group 1 Assignment"
                 default="CY_ALLOCATE_PERIPHERAL_TO_CPU0">
      <Entry name="CPU0" value="CY_ALLOCATE_PERIPHERAL_TO_CPU0" visible="true"/>
      <Entry name="CPU1" value="CY_ALLOCATE_PERIPHERAL_TO_CPU1" visible="`${cpu1Enable}`"/>
    </ParamChoice>
    <ParamString id="dcsgGrp1Fill" name="dcsgGrp1_fill" group="Internal" default="`${(dcsgGrp1 eq CY_ALLOCATE_PERIPHERAL_TO_CPU0) ? ocean : berry}`" visible="false" editable="false" desc="" />

    <Repeat count="16">
	  <ParamSignal port="ppssin_sel_src[$idx]" name="ppcain_sel_src[$idx]" group="PPCA_IN Configuration" visible="`${hasVisibleOption(&quot;ppssin_sel_src[$idx]&quot;)}`" desc="Source for PPCA IN configuration." canBeEmpty="true" >
		  <Constraint type="ACCEPT" targetLocation="ioss\[\d+\]\.port\[\d+\]\.pin.*" valid="true" >
			<Parameter id="DriveModes" severity="DEFAULT" reason="">
			  <Fixed value="CY_GPIO_DM_HIGHZ" />
			</Parameter>
		  </Constraint>
		  <Constraint type="ACCEPT" targetLocation="ioss\[\d+\]\.port\[\d+\]\.pin.*" valid="true" >
			<Parameter id="DriveModes" severity="INFO" reason="The pin Drive Mode parameter does not match expected.">
			  <Fixed value="CY_GPIO_DM_HIGHZ" />
			</Parameter>
		  </Constraint>
		  <Constraint type="ACCEPT" targetLocation=".*" valid="true" />
      </ParamSignal>
      <ParamSignal port="ppssin_sel[$idx]" name="ppcain_sel[$idx]" visible="`${hasVisibleOption(&quot;ppssin_sel[$idx]&quot;)}`" canBeEmpty="true" group="PPCA_IN Configuration" desc="PPCA In configuration" />

	  <ParamSignal port="tr_ppssin_sel_src[$idx]" name="tr_ppcain_sel_src[$idx]" group="PPCA_IN trigger Configuration" visible="`${hasVisibleOption(&quot;tr_ppssin_sel_src[$idx]&quot;)}`" desc="Source for PPCA_IN trigger configuration." canBeEmpty="true" >
		  <Constraint type="ACCEPT" targetLocation="ioss\[\d+\]\.port\[\d+\]\.pin.*" valid="true" >
			<Parameter id="DriveModes" severity="DEFAULT" reason="">
			  <Fixed value="CY_GPIO_DM_HIGHZ" />
			</Parameter>
		  </Constraint>
		  <Constraint type="ACCEPT" targetLocation="ioss\[\d+\]\.port\[\d+\]\.pin.*" valid="true" >
			<Parameter id="DriveModes" severity="INFO" reason="The pin Drive Mode parameter does not match expected.">
			  <Fixed value="CY_GPIO_DM_HIGHZ" />
			</Parameter>
		  </Constraint>
		  <Constraint type="ACCEPT" targetLocation=".*" valid="true" />
      </ParamSignal>
      <ParamSignal port="tr_ppssin_sel[$idx]" name="tr_ppcain_sel[$idx]" visible="`${hasVisibleOption(&quot;tr_ppssin_sel[$idx]&quot;)}`" canBeEmpty="true" group="PPCA_IN trigger Configuration" desc="PPCA_IN trigger configuration" />

    </Repeat>

    <!-- PPCA OUT Config -->
    <ParamBool id="ppcaOutSelEn" name="Enable PPCA Output Selector" group="PPCA_OUT Configuration" default="false" visible="true" editable="true" desc="This parameter enables/disables PPCA Output Selector."/>
    <ParamChoice id="ppcaOutSel"
                 name="PPCA Output Selector"
                 group="PPCA_OUT Configuration"
                 visible="`${ppcaOutSelEn}`"
                 editable="true"
                 desc="PPCA Output Selector"
                 default="CY_PPCAOUT_TCPWM_OUTPUT">
      <Entry name="TCPWM Output" value="CY_PPCAOUT_TCPWM_OUTPUT" visible="true"/>
      <Entry name="CLB Output" value="CY_PPCAOUT_CLB_OUPTUT" visible="true"/>
    </ParamChoice>
    <!--Repeat count="52">
      <ParamSignal port="tr_ppssout_sel[$idx]" name="tr_ppcaout_sel[$idx]" visible="`${(ppcaOutSelEn) &amp;&amp; (hasVisibleOption(&quot;tr_ppssout_sel[$idx]&quot;))}`" canBeEmpty="true" group="PPCA_OUT Configuration" desc="" />
    </Repeat-->

    <ParamRange id="puty1ResAlloc" name="puty1ResAlloc" group="Internal" default="`${isBlockUsed(&quot;ppca[0].epu[0]&quot;) ? getExposedMember(&quot;ppca[0].epu[0]&quot;, &quot;puty1ResAlloc&quot;) : 0}`" min="0" max="4294967295" resolution="1" visible="false" editable="false" desc="" />
    <ParamRange id="puty2ResAlloc" name="puty2ResAlloc" group="Internal" default="`${isBlockUsed(&quot;ppca[0].epu[0]&quot;) ? getExposedMember(&quot;ppca[0].epu[0]&quot;, &quot;puty2ResAlloc&quot;) : 0}`" min="0" max="65535" resolution="1" visible="false" editable="false" desc="" />

    <ParamImage id="mxs40ppca_diagram"
                name="MXS40PPCA Subsystem"
                group="PPCA Configuration"
                desc=""
                visible="true"
                position="OUTSET"
                default="`${cy_libs_path()}`/device-info/personalities/ppca/PPCA_Block_diagram.svg">
    <Substitution name="cpu1_color" value="`${cpu1_fill}`"/>
    <Substitution name="mem0_color" value="`${m0_fill}`"/>
    <Substitution name="mem1_color" value="`${m1_fill}`"/>
    <Substitution name="mem2_color" value="`${m2_fill}`"/>
    <Substitution name="mem3_color" value="`${m3_fill}`"/>
    <Substitution name="pwm_ss0_color" value="`${pwmSS0Fill}`"/>
    <Substitution name="pwm_ss1_color" value="`${pwmSS1Fill}`"/>
    <Substitution name="pwm_ss2_color" value="`${pwmSS2Fill}`"/>
    <Substitution name="pwm_ss3_color" value="`${pwmSS3Fill}`"/>
    <Substitution name="hw_fltr0_color" value="`${hwfilt3p3zSS0Fill}`"/>
    <Substitution name="hw_fltr1_color" value="`${hwfilt3p3zSS1Fill}`"/>
    <Substitution name="adc_mirror_color" value="`${adcMirrorFill}`"/>
    <Substitution name="clb_color" value="`${clbFill}`"/>
    <Substitution name="cordic_ss0_color" value="`${cordicSS0Fill}`"/>
    <Substitution name="cordic_ss1_color" value="`${cordicSS1Fill}`"/>
    <Substitution name="adc_ss0_color" value="`${adcGrp0Fill}`"/>
    <Substitution name="adc_ss1_color" value="`${adcGrp1Fill}`"/>
    <Substitution name="adc_ss2_color" value="`${adcGrp2Fill}`"/>
    <Substitution name="adc_ss3_color" value="`${adcGrp3Fill}`"/>
    <Substitution name="dcsg_ss0_color" value="`${dcsgGrp0Fill}`"/>
    <Substitution name="dcsg_ss1_color" value="`${dcsgGrp1Fill}`"/>
    </ParamImage>

    <ParamString id="HF3Rsc" name="HF3Rsc" group="Internal" default="srss[0].clock[0].hfclk[3]" visible="false" editable="false" desc="" />
    <ParamBool id="HF3Used" name="HF3Used" group="Internal" default="`${isBlockUsed(HF3Rsc)}`" visible="false" editable="false" desc="" />
    <ParamRange id="HF3Freq" name="HF3Freq" group="Internal" default="`${HF3Used ? getExposedMember(HF3Rsc, &quot;frequency&quot;) : 0}`" min="0" max="400000000" resolution="1" visible="false" editable="false" desc="HF3 clock frequency used for PPCA" />

    <ParamBool id="init" name="Initialize During Startup" group="Advanced" default="true" visible="true" editable="true" desc="Performs an automatic initialization in the init_cycfg_peripherals() generated function." />
    <ParamBool id="inFlash" name="Store Config in Flash" group="Advanced" default="true" visible="true" editable="true" desc="Controls whether the configuration structure is stored in flash (const, true) or SRAM (not const, false)." />
  </Parameters>
  <DRCs>
    <DRC type="ERROR" text="Enable Clock HF3 For PPCA." condition="`${!HF3Used}`">
      <FixIt action="ENABLE_BLOCK" target="`${HF3Rsc}`" value="" valid="true" />
    </DRC>
    <DRC type="ERROR" text="CLK_HF3 frequency exceeds the maximum allowed 200 MHz for PPCA." condition="`${HF3Used &amp;&amp; (HF3Freq &gt; 200000000)}`" />
  </DRCs>

  <ConfigFirmware>

    <ConfigInclude value="cy_ppca_cnfg.h" include="true" />
    <ConfigDefine name="`${INST_NAME}`_HW" value="PPCA_CNFG" public="true" include="true" />
    <ConfigDefine name="`${INST_NAME}`CNFG_HW" value="PPCA_CNFG_CNFG" public="true" include="true" />
    <ConfigDefine name="`${INST_NAME}`_IRQ" value="ppca_cnfg_rdy_for_dslp_IRQn" public="true" include="true" />
    <ConfigDefine name="CY_CFG_SYSCLK_PPCA" value="`${HF3Freq}`UL" public="true" include="true" />
    <ConfigDefine name="PPCA_INPUT_SRC_SELECT$idx" value="$idx" public="true" include="`${hasConnection(&quot;ppssin_sel&quot;, $idx)}`" repeatCount="16" />
    <ConfigDefine name="PPCA_TR_INPUT_SRC_SELECT$idx" value="$idx" public="true" include="`${hasConnection(&quot;tr_ppssin_sel&quot;, $idx)}`" repeatCount="16" />
    <!--ConfigDefine name="PPCA_TR_OUTPUT_SRC_SELECT$idx" value="$idx" public="true" include="`${hasConnection(&quot;tr_ppssout_sel&quot;, $idx)}`" repeatCount="52" /-->

    <ConfigStruct name="`${INST_NAME}`_controlConfig" type="cy_stc_ppca_control_config_t" const="`${inFlash}`"  public="true" include="true" >
      <Member name="pwmSS0" value="`${(!cpu1Enable) ? CY_ALLOCATE_PERIPHERAL_TO_CPU0 : pwmSS0}`" />
      <Member name="pwmSS1" value="`${(!cpu1Enable) ? CY_ALLOCATE_PERIPHERAL_TO_CPU0 : pwmSS1}`" />
      <Member name="pwmSS2" value="`${(!cpu1Enable) ? CY_ALLOCATE_PERIPHERAL_TO_CPU0 : pwmSS2}`" />
      <Member name="pwmSS3" value="`${(!cpu1Enable) ? CY_ALLOCATE_PERIPHERAL_TO_CPU0 : pwmSS3}`" />
      <Member name="HWFILT3P3Z_SS0" value="`${(!cpu1Enable) ? CY_ALLOCATE_PERIPHERAL_TO_CPU0 : hwfilt3p3zSS0}`" />
      <Member name="HWFILT3P3Z_SS1" value="`${(!cpu1Enable) ? CY_ALLOCATE_PERIPHERAL_TO_CPU0 : hwfilt3p3zSS1}`" />
      <Member name="ADCMirror" value="`${(!cpu1Enable) ? CY_ALLOCATE_PERIPHERAL_TO_CPU0 : adcMirror}`" />
