    <ParamBool id="cpu1Enable" name="Enable CPU1" group="General" default="false" visible="`${!remapMem &amp;&amp; hasBlock(&quot;ppca[0].cpuss_cnfg[0].mxcm33[1]&quot;)}`" editable="`${!remapMem &amp;&amp; hasBlock(&quot;ppca[0].cpuss_cnfg[0].mxcm33[1]&quot;)}`" desc="This parameter enables/disables CPU1 Clock"/>
    <ParamString id="cpu1_fill" name="cpu1_fill" group="Internal" default="`${(cpu1Enable) ? berry : grey}`" visible="false" editable="false" desc="" />
    <ParamString id="m0_fill" name="m0_fill" group="Internal" default="`${ocean}`" visible="false" editable="false" desc="" />
    <ParamString id="m1_fill" name="m1_fill" group="Internal" default="`${ocean}`" visible="false" editable="false" desc="" />
    <ParamString id="m2_fill" name="m2_fill" group="Internal" default="`${(cpu1Enable) ? berry : ocean}`" visible="false" editable="false" desc="" />
    <ParamString id="m3_fill" name="m3_fill" group="Internal" default="`${(cpu1Enable) ? berry : ocean}`" visible="false" editable="false" desc="" />

    <ParamChoice id="pwmSS0"
                 name="PWM SS0"
                 group="PPCA Configuration"
                 visible="true"
                 editable="true"
                 desc="PWM SS0 Assignment"
                 default="CY_ALLOCATE_PERIPHERAL_TO_CPU0">
      <Entry name="CPU0" value="CY_ALLOCATE_PERIPHERAL_TO_CPU0" visible="true"/>
      <Entry name="CPU1" value="CY_ALLOCATE_PERIPHERAL_TO_CPU1" visible="`${cpu1Enable}`"/>
    </ParamChoice>
    <ParamString id="pwmSS0Fill" name="pwmSS0_fill" group="Internal" default="`${(pwmSS0 eq CY_ALLOCATE_PERIPHERAL_TO_CPU0) ? ocean : berry}`" visible="false" editable="false" desc="" />

    <ParamChoice id="pwmSS1"
