    <ParamString id="hwfilt3p3zSS1Fill" name="hwfilt3p3zSS1_fill" group="Internal" default="`${(hwfilt3p3zSS1 eq CY_ALLOCATE_PERIPHERAL_TO_CPU0) ? ocean : berry}`" visible="false" editable="false" desc="" />

    <ParamChoice id="adcMirror"
                 name="ADC Mirror"
                 group="PPCA Configuration"
                 visible="true"
                 editable="true"
                 desc="ADC Mirror Assignment"
