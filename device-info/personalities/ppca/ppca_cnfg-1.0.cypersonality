                 default="CY_ALLOCATE_PERIPHERAL_TO_CPU0">
      <Entry name="CPU0" value="CY_ALLOCATE_PERIPHERAL_TO_CPU0" visible="true"/>
      <Entry name="CPU1" value="CY_ALLOCATE_PERIPHERAL_TO_CPU1" visible="`${cpu1Enable}`"/>
    </ParamChoice>
    <ParamString id="adcGrp3Fill" name="adcGrp3_fill" group="Internal" default="`${(adcGrp3 eq CY_ALLOCATE_PERIPHERAL_TO_CPU0) ? ocean : berry}`" visible="false" editable="false" desc="" />

    <ParamChoice id="dcsgGrp0"
                 name="DCSG Group 0"
                 group="PPCA Configuration"
                 visible="true"
                 editable="true"
