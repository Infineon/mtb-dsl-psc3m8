    </ParamChoice>
    <ParamString id="adcMirrorFill" name="adcMirror_fill" group="Internal" default="`${(adcMirror eq CY_ALLOCATE_PERIPHERAL_TO_CPU0) ? ocean : berry}`" visible="false" editable="false" desc="" />

    <ParamChoice id="clb"
                 name="CLB"
                 group="PPCA Configuration"
                 visible="true"
                 editable="true"
                 desc="CLB Assignment"
                 default="CY_ALLOCATE_PERIPHERAL_TO_CPU0">
      <Entry name="CPU0" value="CY_ALLOCATE_PERIPHERAL_TO_CPU0" visible="true"/>
      <Entry name="CPU1" value="CY_ALLOCATE_PERIPHERAL_TO_CPU1" visible="`${cpu1Enable}`"/>
    </ParamChoice>
    <ParamString id="clbFill" name="clb_fill" group="Internal" default="`${(clb eq CY_ALLOCATE_PERIPHERAL_TO_CPU0) ? ocean : berry}`" visible="false" editable="false" desc="" />

    <ParamChoice id="cordicSS0"
                 name="Cordic SS0"
                 group="PPCA Configuration"
                 visible="true"
                 editable="true"
                 desc="CORDIC SS0 Assignment"
                 default="CY_ALLOCATE_PERIPHERAL_TO_CPU0">
      <Entry name="CPU0" value="CY_ALLOCATE_PERIPHERAL_TO_CPU0" visible="true"/>
      <Entry name="CPU1" value="CY_ALLOCATE_PERIPHERAL_TO_CPU1" visible="`${cpu1Enable}`"/>
    </ParamChoice>
    <ParamString id="cordicSS0Fill" name="cordicSS0_fill" group="Internal" default="`${(cordicSS0 eq CY_ALLOCATE_PERIPHERAL_TO_CPU0) ? ocean : berry}`" visible="false" editable="false" desc="" />

    <ParamChoice id="cordicSS1"
                 name="Cordic SS1"
                 group="PPCA Configuration"
                 visible="true"
                 editable="true"
                 desc="CORDIC SS1 Assignment"
                 default="CY_ALLOCATE_PERIPHERAL_TO_CPU0">
      <Entry name="CPU0" value="CY_ALLOCATE_PERIPHERAL_TO_CPU0" visible="true"/>
