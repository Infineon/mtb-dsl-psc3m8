    <ParamChoice id="adcGrp0"
                 name="ADC Group 0"
                 group="PPCA Configuration"
                 visible="true"
                 editable="true"
                 desc="ADC Group 0 Assignment"
                 default="CY_ALLOCATE_PERIPHERAL_TO_CPU0">
      <Entry name="CPU0" value="CY_ALLOCATE_PERIPHERAL_TO_CPU0" visible="true"/>
      <Entry name="CPU1" value="CY_ALLOCATE_PERIPHERAL_TO_CPU1" visible="`${cpu1Enable}`"/>
    </ParamChoice>
    <ParamString id="adcGrp0Fill" name="adcGrp0_fill" group="Internal" default="`${(adcGrp0 eq CY_ALLOCATE_PERIPHERAL_TO_CPU0) ? ocean : berry}`" visible="false" editable="false" desc="" />

