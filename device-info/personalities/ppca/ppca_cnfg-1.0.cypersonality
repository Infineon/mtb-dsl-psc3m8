    <ParamString id="pwmSS2Fill" name="pwmSS2_fill" group="Internal" default="`${(pwmSS2 eq CY_ALLOCATE_PERIPHERAL_TO_CPU0) ? ocean : berry}`" visible="false" editable="false" desc="" />

    <ParamChoice id="pwmSS3"
