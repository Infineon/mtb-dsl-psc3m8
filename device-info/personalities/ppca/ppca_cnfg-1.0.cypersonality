    <ParamString id="ocean" name="ocean" group="Internal" default="#3b9b91" visible="false" editable="false" desc="" />
    <ParamString id="berry" name="berry" group="Internal" default="#be3283" visible="false" editable="false" desc="" />
    <ParamString id="grey" name="grey" group="Internal" default="#cccccc" visible="false" editable="false" desc="" />

    <ParamBool id="dpslpRetentionEnable" name="Enable DeepSleep Retention" group="General" default="false" visible="true" editable="true" desc="This parameter enables/disables PPCA Deepsleep Retention "/>
    <ParamBool id="clkShutDown" name="Enable Clock Shut Down" group="General" default="false" visible="true" editable="true" desc="This parameter enables/disables PPCA Clock Shut Down "/>
    <ParamBool id="remapMem" name="Enable Remap Memory" group="General" default="false" visible="true" editable="true" desc="This parameter enables/disables PPCA BusMatrix Remap, when enabled reduced data memory is set and CPU1 will not have any memory allocated. CPU1 should be disabled. "/>
    <ParamBool id="cpu0HRESPError" name="Enable CPU0 HRESP Error" group="General" default="false" visible="true" editable="true" desc="This parameter enables/disables CPU0 HRESP ERROR propagation as Fault Enable Control  "/>
