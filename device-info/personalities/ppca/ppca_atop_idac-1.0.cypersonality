<?xml version="1.0" encoding="utf-8"?>

<PersonalityTemplate id="mxs40ppca_idac" name="IDAC" version="1.0" xmlns="http://cypress.com/xsd/cyhwpersonality_v10">
  <FittingRules>
    <MappingRules>
      <IpBlock name="mxs40ppss" />
      <Resource name="ppca\.atop\.adc_grp\.idac" />
    </MappingRules>
  </FittingRules>
  <Parameters>
     <!-- PDL documentation -->
    <ParamDoc id="pdlDoc" name="Configuration Help" group="Overview" default="file:///`${cy_libs_path()}`/docs/html/group__group__ppca__aref.html" linkText="Open PPCA IDAC Documentation" visible="true" desc="Opens the Peripheral Driver Library Documentation" />
    <ParamString id="adcGroupNumber" name="ADC Group Number" group="Internal" default="`${getInstNumber(&quot;adc_grp&quot;)}`" visible="false" editable="false" desc="ADC Group name number." />
    <ParamChoice id="idac_mode_cnfg"
             name="POR Analog control configuration"
             group="IDAC Configuration"
             visible="true"
             editable="true"
             desc="IDAC Mode Configuration."
             default="CY_IDAC_CNFG_MODE_TRISTATE">
        <Entry name="Tri State" value="CY_IDAC_CNFG_MODE_TRISTATE" visible="true"/>
        <Entry name="AI 0" value="CY_IDAC_CNFG_MODE_AI0" visible="true"/>
        <Entry name="AI 1" value="CY_IDAC_CNFG_MODE_AI1" visible="true"/>
        <Entry name="DCSG VINP" value="CY_IDAC_CNFG_MODE_DCSG_VINP" visible="true"/>
        <Entry name="DCSG VINN" value="CY_IDAC_CNFG_MODE_DCSG_VINN" visible="true"/>
    </ParamChoice>
    <ParamString id="arefRsc" name="arefRsc" group="Internal" default="ppca[0].atop[0].adc_grp[0].aref[0]" visible="false" editable="false" desc="" />
    <ParamString id="arefUsed" name="arefUsed" group="Internal" default="`${isBlockUsed(arefRsc)}`" visible="false" editable="false" desc="" />

    <ParamBool id="init" name="Initialize During Startup" group="Advanced" default="true" visible="true" editable="true" desc="Performs an automatic initialization in the init_cycfg_peripherals() generated function." />
    <ParamBool id="inFlash" name="Store Config in Flash" group="Advanced" default="true" visible="true" editable="true" desc="Controls whether the configuration structure is stored in flash (const, true) or SRAM (not const, false)." />
  </Parameters>
  <DRCs>
    <DRC type="ERROR" text="Enable AREF in ADC Group0 and configure VREF Source accordingly." condition="`${!arefUsed}`">
      <FixIt action="ENABLE_BLOCK" target="`${arefRsc}`" value="" valid="true" />
    </DRC>
  </DRCs>

  <ConfigFirmware>

    <ConfigInclude value="cy_ppca_aref.h" include="true" />
    <ConfigDefine name="`${INST_NAME}`_HW" value="PPCA_ATOPSS_ADC_GRP`${adcGroupNumber}`_IDAC" public="true" include="true" />

    <ConfigStruct name="`${INST_NAME}`_config" type="cy_stc_ppca_idac_config_t" const="`${inFlash}`" public="true" include="true" >
      <Member name="idac_mode_cnfg" value="`${idac_mode_cnfg}`" />
    </ConfigStruct>

    <ConfigInstruction value="Cy_PPCA_IDAC_Init(`${INST_NAME}`_HW, &amp;`${INST_NAME}`_config);" include="`${init}`" purpose="INITIALIZE" />

  </ConfigFirmware>
</PersonalityTemplate>