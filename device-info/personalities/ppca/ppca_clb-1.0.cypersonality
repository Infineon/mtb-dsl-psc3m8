<?xml version="1.0" encoding="utf-8"?>

<PersonalityTemplate id="mxs40ppca-clb" name="mxs40ppca-clb" version="1.0" xmlns="http://cypress.com/xsd/cyhwpersonality_v10">
  <FittingRules>
    <MappingRules>
      <IpBlock name="mxs40ppss" />
      <Resource name="ppca\.clb" />
    </MappingRules>
  </FittingRules>
  <ExposedMembers />

  <Parameters>
    <!-- PDL documentation -->
    <ParamDoc id="pdlDoc" name="Configuration Help" group="Overview" default="file:///`${cy_libs_path()}`/docs/html/group__group__ppca__clb.html" linkText="Open PPCA CLB Documentation" visible="true" desc="Opens the Peripheral Driver Library Documentation" />

    <ParamChoice id="clbOutput" name="CLB Output" group="CLB Configuration" default="CY_CLB_DICO_SEL" visible="true" editable="true" desc="Selects CLB Output between DICO and MACO functionality.">
      <Entry name="DICO Mode" value="CY_CLB_DICO_SEL" visible="true" />
      <Entry name="MACO Mode" value="CY_CLB_MACO_SEL" visible="true" />
    </ParamChoice>


    <!--DICO-->

    <ParamBool id="enablePhase1" name="Enable Phase 1" group="DICO Configuration" default="false" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter enables Phase 1 "/>
    <ParamBool id="enablePhase2" name="Enable Phase 2" group="DICO Configuration" default="false" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter enables Phase 2 "/>
    <ParamBool id="enablePhase3" name="Enable Phase 3" group="DICO Configuration" default="false" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter enables Phase 3 "/>
    <ParamBool id="enablePhaseEnabler" name="Enable PE (Phase Enabler)" group="DICO Configuration" default="false" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter enables PE (Phase Enabler) "/>

    <!-- TBD: Should default be unassigned ? -->
    <ParamChoice id="vac" name="VAC" group="DICO Configuration" default="CY_ADC_GROUP_0_FILT_OUT0" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="Select ADC FILT out as input to VAC.">
      <Entry name="ADC GROUP_0 FILTER OUT0" value="CY_ADC_GROUP_0_FILT_OUT0" visible="true" />
      <Entry name="ADC GROUP_0 FILTER OUT1" value="CY_ADC_GROUP_0_FILT_OUT1" visible="true" />
      <Entry name="ADC GROUP_1 FILTER OUT2" value="CY_ADC_GROUP_1_FILT_OUT2" visible="true" />
      <Entry name="ADC GROUP_2 FILTER OUT3" value="CY_ADC_GROUP_2_FILT_OUT3" visible="true" />
      <Entry name="ADC GROUP_3 FILTER OUT4" value="CY_ADC_GROUP_3_FILT_OUT4" visible="true" />
      <Entry name="ADC GROUP_3 FILTER OUT5" value="CY_ADC_GROUP_3_FILT_OUT5" visible="true" />
    </ParamChoice>

    <!-- TBD: Should default be unassigned ? -->
    <ParamChoice id="vbus" name="VBUS" group="DICO Configuration" default="CY_ADC_GROUP_0_FILT_OUT0" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="Select ADC FILT out as input to VBUS.">
      <Entry name="ADC GROUP_0 FILTER OUT0" value="CY_ADC_GROUP_0_FILT_OUT0" visible="true" />
      <Entry name="ADC GROUP_0 FILTER OUT1" value="CY_ADC_GROUP_0_FILT_OUT1" visible="true" />
      <Entry name="ADC GROUP_1 FILTER OUT2" value="CY_ADC_GROUP_1_FILT_OUT2" visible="true" />
      <Entry name="ADC GROUP_2 FILTER OUT3" value="CY_ADC_GROUP_2_FILT_OUT3" visible="true" />
      <Entry name="ADC GROUP_3 FILTER OUT4" value="CY_ADC_GROUP_3_FILT_OUT4" visible="true" />
      <Entry name="ADC GROUP_3 FILTER OUT5" value="CY_ADC_GROUP_3_FILT_OUT5" visible="true" />
    </ParamChoice>

    <!-- TBD: Should default be unassigned ? -->
    <Repeat count="3">
        <ParamChoice id="il$idx" name="IL `${$idx+1}`" group="DICO Configuration" default="CY_ADC_GROUP_0_FILT_OUT0" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="Select ADC FILT out as input to IL $idx.">
          <Entry name="ADC GROUP_0 FILTER OUT0" value="CY_ADC_GROUP_0_FILT_OUT0" visible="true" />
          <Entry name="ADC GROUP_0 FILTER OUT1" value="CY_ADC_GROUP_0_FILT_OUT1" visible="true" />
          <Entry name="ADC GROUP_1 FILTER OUT2" value="CY_ADC_GROUP_1_FILT_OUT2" visible="true" />
          <Entry name="ADC GROUP_2 FILTER OUT3" value="CY_ADC_GROUP_2_FILT_OUT3" visible="true" />
          <Entry name="ADC GROUP_3 FILTER OUT4" value="CY_ADC_GROUP_3_FILT_OUT4" visible="true" />
          <Entry name="ADC GROUP_3 FILTER OUT5" value="CY_ADC_GROUP_3_FILT_OUT5" visible="true" />
        </ParamChoice>
    </Repeat>

    <ParamChoice id="vacPol" name="VAC Polarity" group="DICO Configuration" default="CY_NEG_VAC_POL" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter selects the VAC Polarity.">
      <Entry name="Negative Polarity" value="CY_NEG_VAC_POL" visible="true" />
      <Entry name="Zero Polarity" value="CY_ZERO_VAC_POL" visible="true" />
      <Entry name="Positive Polarity" value="CY_POS_VAC_POL" visible="true" />
    </ParamChoice>


    <ParamChoice id="numPeriod" name="Switching Period" group="DICO Error Observer Configuration" default="CY_SINGLE_PERIOD" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="Error Observer: Number of periods to be measured.">
      <Entry name="Single Period" value="CY_SINGLE_PERIOD" visible="true" />
      <Entry name="Two Periods" value="CY_TWO_PERIODS" visible="true" />
      <Entry name="Three Periods" value="CY_THREE_PERIODS" visible="true" />
      <Entry name="Four Periods" value="CY_FOUR_PERIODS " visible="true" />
    </ParamChoice>

    <ParamRange id="pwmDeadTime" name="PWM Deadtime" group="DICO Modulator Configuration" default="0" min="0" max="127" resolution="1" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter configures the PWM Deadtime." />
    <ParamBool id="skipSlopeCal" name="Skip Slope Calculation" group="DICO Modulator Configuration" default="false" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter for PE: Skip FSM states for calculating UP and DOWN slope"/>
    <ParamBool id="recalSlope" name="Recalculate Slope" group="DICO Modulator Configuration" default="false" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter for PE: Recalculate slopes when in the state of PE_IDLE1 "/>

    <ParamChoice id="monitorSignalSel" name="Signals to monitor" group="DICO Modulator Configuration" default="CY_PCO_0_SIGNALS" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="Error Observer: Number of periods to be measured.">
      <Entry name="PCO_0 Signals" value="CY_PCO_0_SIGNALS" visible="true" />
      <Entry name="PCO_1 Signals" value="CY_PCO_1_SIGNALS" visible="true" />
      <Entry name="PCO_2 Signals" value="CY_PCO_2_SIGNALS" visible="true" />
      <Entry name="PE Signals" value="CY_PE_SIGNALS " visible="true" />
      <Entry name="PS Signals" value="CY_PS_SIGNALS " visible="true" />
    </ParamChoice>

    <ParamBool id="onlyCorrCharg" name="Correction Charge" group="DICO Modulator Configuration" default="false" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter, if enabled, corrects only the IMIN or IMAX reached during the charging phase. "/>

    <ParamRange id="safeState" name="Safe State" group="DICO Modulator Configuration" default="0" min="0" max="63" resolution="1" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter configures safe state of DICO output.." />

    <ParamRange id="imaxl" name="Maximum Current: IMAXL" group="DICO Modulator Configuration" default="0" min="0" max="16777215" resolution="1" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter configures the maximum current." />
    <ParamRange id="iminl" name="Minimum Current: IMINL" group="DICO Modulator Configuration" default="0" min="0" max="16777215" resolution="1" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter configures the minimum current." />

    <ParamRange id="pwmMaxOnTime" name="PWM Max ON Time" group="DICO Modulator Configuration" default="4095" min="0" max="4095" resolution="1" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter configures the value at which PWM switching is forced when reached." />
    <ParamRange id="pwmMinOnTime" name="PWM Min ON Time" group="DICO Modulator Configuration" default="0" min="0" max="4095" resolution="1" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter configures the value at which PWM switching is enabled when reached." />

    <ParamRange id="peTPHD1" name="PCO_1 TPHD" group="MPA: Phase Enabler Configuration" default="0" min="0" max="4095" resolution="1" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter configures the TPHD value for activating PCO_1." />
    <ParamRange id="peTPHD2" name="PCO_2 TPHD" group="MPA: Phase Enabler Configuration" default="0" min="0" max="4095" resolution="1" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter configures the TPHD value for activating PCO_2." />

    <ParamRange id="psThld" name="Phase Synchronizer Threshold" group="MPA: Phase Synchronizer Configuration" default="0" min="0" max="16777215" resolution="1" visible="`${clbOutput eq CY_CLB_DICO_SEL}`" editable="true" desc="This parameter configures the threshold for the comparator in Phase Synchronizer (PS)." />

    <!-- MACO -->

    <ParamChoice id="muxselInSrcSel" name="Input Source" group="MACO Configuration" default="CY_INTERNAL" visible="`${clbOutput eq CY_CLB_MACO_SEL}`" editable="true" desc="This parameter selects the MUXSEL_IN input source.">
      <Entry name="Internal" value="CY_INTERNAL" visible="true" />
      <Entry name="External(CLB_TRIG_IN[2])" value="CY_EXTERNAL" visible="true" />
    </ParamChoice>

    <ParamChoice id="muxselOutSyncBypass" name="Bypass Mode" group="MACO Configuration" default="CY_ASYNC_REL" visible="`${clbOutput eq CY_CLB_MACO_SEL}`" editable="true" desc="This parameter selects between the synchronous or asynchronous release of generated MUXSEL_OUT.">
      <Entry name="Asynchronous" value="CY_ASYNC_REL" visible="true" />
      <Entry name="Synchronous to CLB_TRIG_IN[3]" value="CY_SYNC_REL" visible="true" />
    </ParamChoice>

    <ParamChoice id="startMode" name="Start Mode" group="MACO Configuration" default="CY_START_WITH_ENABLE_BIT" visible="`${clbOutput eq CY_CLB_MACO_SEL}`" editable="true" desc="This parameter selects the start mode.">
      <Entry name="Start with Enable bit" value="CY_START_WITH_ENABLE_BIT" visible="true" />
      <Entry name="Wait for trigger CLB_TRIG_IN[4] before start(after enable has been set)" value="CY_WAIT_FOR_TRIGGER" visible="true" />
    </ParamChoice>

    <ParamChoice id="transitionMode" name="Transition Mode" group="MACO Configuration" default="CY_MANUAL_TRANSITION" visible="`${clbOutput eq CY_CLB_MACO_SEL}`" editable="true" desc="This parameter selects the table transition mode.">
      <Entry name="Manual Transition" value="CY_MANUAL_TRANSITION" visible="true" />
      <Entry name="Auto Transition" value="CY_AUTO_TRANSITION" visible="true" />
    </ParamChoice>

    <ParamChoice id="macoFunc" name="Function of MACO" group="MACO Configuration" default="CY_MATRIX_CONVERTER" visible="`${clbOutput eq CY_CLB_MACO_SEL}`" editable="true" desc="This parameter selects the MACO functionality.">
      <Entry name="Matrix Converter" value="CY_MATRIX_CONVERTER" visible="true" />
      <Entry name="Trajectory Control" value="CY_TRAJECTORY_CONTROL" visible="true" />
    </ParamChoice>

    <ParamChoice id="monitorSel" name="Signals to monitor" group="MACO Configuration" default="CY_PATTERN_ROW_COUTER_LSB" visible="`${clbOutput eq CY_CLB_MACO_SEL}`" editable="true" desc="This parameter selects the signals to monitor.">
      <Entry name="Pattern (2-bit), Row (5-bit), Counter_LSB (1-bit)" value="CY_PATTERN_ROW_COUTER_LSB" visible="true" />
      <Entry name="Counter (8-bit)" value="CY_COUNTER" visible="true" />
    </ParamChoice>

    <ParamChoice id="selNxtSec" name="Select Next Sector for Scan" group="MACO Configuration" default="CY_CURRENT_SECTOR" visible="`${clbOutput eq CY_CLB_MACO_SEL}`" editable="true" desc="This parameter selects the next sector pattern to be scanned.">
      <Entry name="Current Sector" value="CY_CURRENT_SECTOR" visible="true" />
      <Entry name="Next Sector" value="CY_NEXT_SECTOR" visible="true" />
      <Entry name="Previous Sector" value="CY_PREVIOUS_SECTOR" visible="true" />
    </ParamChoice>

    <Repeat count="3">
        <ParamRange id="tranRow$idx" name="Number of Rows in Transition Table" group="Sector $idx Pattern $idx" default="0" min="0" max="65535" resolution="1" visible="`${clbOutput eq CY_CLB_MACO_SEL}`" editable="true" desc="This parameter configures the number of rows in the transition table." />
        <ParamRange id="allRow$idx" name="Number of Rows in the Entire Table" group="Sector $idx Pattern $idx" default="0" min="0" max="65535" resolution="1" visible="`${clbOutput eq CY_CLB_MACO_SEL}`" editable="true" desc="This parameter configures the number of rows in the entire table." />
        <ParamRange id="safeState$idx" name="Safe State" group="Sector $idx Pattern $idx" default="0" min="0" max="65535" resolution="1" visible="`${clbOutput eq CY_CLB_MACO_SEL}`" editable="true" desc="This parameter configures the Safe Status of Driver Signals controlling the switches ." />
        <Repeat count="20">
            <ParamRange id="driverSignal$idx{0}_$idx{1}" name="Driver Signal $idx{0}" group="Sector $idx{1} Pattern $idx{1}" default="0" min="0" max="65535" resolution="1" visible="`${clbOutput eq CY_CLB_MACO_SEL}`" editable="true" desc="This parameter configures the Status of Driver Signals controlling the switches." />
        </Repeat>
        <Repeat count="20">
            <ParamRange id="holdTime$idx{0}_$idx{1}" name="Hold Time $idx{0}" group="Sector $idx{1} Pattern $idx{1}" default="0" min="0" max="255" resolution="1" visible="`${clbOutput eq CY_CLB_MACO_SEL}`" editable="true" desc="This parameter configures the Scan Pattern Hold Time in clock cycles ." />
        </Repeat>
    </Repeat>

    <ParamSignal port="clb_out[0]" name="End of Scan" visible="`${(clbOutput eq CY_CLB_MACO_SEL) &amp;&amp; (hasVisibleOption(&quot;clb_out[0]&quot;))}`" canBeEmpty="true" group="CLB Events to EPU" desc="MACO end of scan event to EPU" />
    <ParamSignal port="clb_out[1]" name="Spread Pulse Startup " visible="`${(clbOutput eq CY_CLB_MACO_SEL) &amp;&amp; (hasVisibleOption(&quot;clb_out[1]&quot;))}`" canBeEmpty="true" group="CLB Events to EPU" desc="Spread Pulse Startup muxsel_out" />
    <ParamSignal port="clb_out[2]" name="Incorrect setting of DICO" visible="`${(clbOutput eq CY_CLB_DICO_SEL) &amp;&amp; (hasVisibleOption(&quot;clb_out[2]&quot;))}`" canBeEmpty="true" group="CLB Events to EPU" desc="Incorrect setting of DICO (polarity)" />
    <ParamSignal port="clb_out[3]" name="Maximum-on time reached signal of PCO0" visible="`${(clbOutput eq CY_CLB_DICO_SEL) &amp;&amp; (hasVisibleOption(&quot;clb_out[3]&quot;))}`" canBeEmpty="true" group="CLB Events to EPU" desc="Maximum-on time reached signal of PCO0" />
    <ParamSignal port="clb_out[4]" name="Maximum-on time not reached signal of PCO0" visible="`${(clbOutput eq CY_CLB_DICO_SEL) &amp;&amp; (hasVisibleOption(&quot;clb_out[4]&quot;))}`" canBeEmpty="true" group="CLB Events to EPU" desc="Minimum-on time not reached signal of PCO0 when the estimated current hits IMIN or IMAX" />


    <Repeat count="16">
      <ParamSignal port="line_out[$idx]" name="line_out[$idx]" visible="`${hasVisibleOption(&quot;line_out[$idx]&quot;)}`" canBeEmpty="true" group="Signals" desc="" />
      <ParamSignal port="line_compl_out[$idx]" name="line_compl_out[$idx]" visible="`${hasVisibleOption(&quot;line_compl_out[$idx]&quot;)}`" canBeEmpty="true" group="Signals" desc="" />
    </Repeat>

    <ParamSignal port="trig_in[0]" name="CLB_TRIG_IN[0]" visible="`${(clbOutput eq CY_CLB_MACO_SEL) &amp;&amp; (hasVisibleOption(&quot;trig_in[0]&quot;))}`" canBeEmpty="true" group="Signals" desc="" />
    <ParamSignal port="trig_in[1]" name="CLB_TRIG_IN[1]" visible="`${(clbOutput eq CY_CLB_MACO_SEL) &amp;&amp; (hasVisibleOption(&quot;trig_in[1]&quot;))}`" canBeEmpty="true" group="Signals" desc="" />
    <ParamSignal port="trig_in[2]" name="CLB_TRIG_IN[2]" visible="`${(clbOutput eq CY_CLB_MACO_SEL) &amp;&amp; (hasVisibleOption(&quot;trig_in[2]&quot;))}`" canBeEmpty="`${muxselInSrcSel ne CY_EXTERNAL}`" group="Signals" desc="" />
    <ParamSignal port="trig_in[3]" name="CLB_TRIG_IN[3]" visible="`${(clbOutput eq CY_CLB_MACO_SEL) &amp;&amp; (hasVisibleOption(&quot;trig_in[3]&quot;))}`" canBeEmpty="`${muxselOutSyncBypass ne CY_SYNC_REL}`" group="Signals" desc="" />
    <ParamSignal port="trig_in[4]" name="CLB_TRIG_IN[4]" visible="`${(clbOutput eq CY_CLB_MACO_SEL) &amp;&amp; (hasVisibleOption(&quot;trig_in[4]&quot;))}`" canBeEmpty="`${startMode ne CY_WAIT_FOR_TRIGGER}`" group="Signals" desc="" />
    <ParamSignal port="trig_in[5]" name="CLB_TRIG_IN[5]" visible="`${(clbOutput eq CY_CLB_MACO_SEL) &amp;&amp; (hasVisibleOption(&quot;trig_in[5]&quot;))}`" canBeEmpty="true" group="Signals" desc="" />

    <Repeat count="16">
        <ParamRange id="power$idx" name="power$idx" group="Internal" default="`${pow(2,$idx)}`" min="0" max="32768" resolution="1" visible="false" editable="false" desc="" />
    </Repeat>

<!-- Pattern 0 -->
    <Repeat count="16">
        <Repeat count="20">
            <ParamRange id="sw$idx{1}st$idx{0}_p0" name="sw$idx{1}st$idx{0}" group="Internal" default="`${(driverSignal$idx{0}_0 &amp; power$idx{1}) ? 1 : 0}`" min="0" max="1" resolution="1" visible="false" editable="false" desc="" />
        </Repeat>
    </Repeat>

<!-- Pattern 1 -->
    <Repeat count="16">
        <Repeat count="20">
            <ParamRange id="sw$idx{1}st$idx{0}_p1" name="sw$idx{1}st$idx{0}" group="Internal" default="`${(driverSignal$idx{0}_1 &amp; power$idx{1}) ? 1 : 0}`" min="0" max="1" resolution="1" visible="false" editable="false" desc="" />
        </Repeat>
    </Repeat>

<!-- Pattern 2 -->
    <Repeat count="16">
        <Repeat count="20">
            <ParamRange id="sw$idx{1}st$idx{0}_p2" name="sw$idx{1}st$idx{0}" group="Internal" default="`${(driverSignal$idx{0}_2 &amp; power$idx{1}) ? 1 : 0}`" min="0" max="1" resolution="1" visible="false" editable="false" desc="" />
        </Repeat>
    </Repeat>

    <ParamString id="white" name="Normal" group="Internal" default="#ffffff" visible="false" editable="false" desc="" />
    <ParamString id="black" name="Lighten" group="Internal" default="#000000" visible="false" editable="false" desc="" />

    <Repeat count="3">
    <ParamImage id="clb_pattern$idx_diagram"
                name="Pattern $idx MACO"
                group="Sector $idx Pattern $idx"
                desc=""
                visible="`${clbOutput eq CY_CLB_MACO_SEL}`"
                position="OUTSET"
                default="`${cy_libs_path()}`/device-info/personalities/ppca/clb_maco_pattern$idx.svg">
                <Substitution name="sw0_st0_l" value="`${sw0st0_p$idx eq 1 ? black : white}`"/>
                <Substitution name="sw0_st0_t" value="`${sw0st0_p$idx eq 1 ? black : white}`"/>
                <Substitution name="sw0_st0_b" value="`${sw0st0_p$idx eq 0 ? black : white}`"/>
                <Substitution name="sw0_st0_st1_rl" value="`${(sw0st0_p$idx eq 1) ? ((sw0st1_p$idx eq 1) ? white : black) : ((sw0st1_p$idx eq 1) ? black : white )}`"/>
                <Substitution name="sw0_st1_t" value="`${sw0st1_p$idx eq 1 ? black : white}`"/>
                <Substitution name="sw0_st1_b" value="`${sw0st1_p$idx eq 0 ? black : white}`"/>
                <Substitution name="sw0_st1_st2_rl" value="`${(sw0st1_p$idx eq 1) ? ((sw0st2_p$idx eq 1) ? white : black) : ((sw0st2_p$idx eq 1) ? black : white )}`"/>
                <Substitution name="sw0_st2_t" value="`${sw0st2_p$idx eq 1 ? black : white}`"/>
                <Substitution name="sw0_st2_b" value="`${sw0st2_p$idx eq 0 ? black : white}`"/>
                <Substitution name="sw0_st2_st3_rl" value="`${(sw0st2_p$idx eq 1) ? ((sw0st3_p$idx eq 1) ? white : black) : ((sw0st3_p$idx eq 1) ? black : white )}`"/>
                <Substitution name="sw0_st3_t" value="`${sw0st3_p$idx eq 1 ? black : white}`"/>
                <Substitution name="sw0_st3_b" value="`${sw0st3_p$idx eq 0 ? black : white}`"/>
                <Substitution name="sw0_st3_st4_rl" value="`${(sw0st3_p$idx eq 1) ? ((sw0st4_p$idx eq 1) ? white : black) : ((sw0st4_p$idx eq 1) ? black : white )}`"/>
                <Substitution name="sw0_st4_t" value="`${sw0st4_p$idx eq 1 ? black : white}`"/>
                <Substitution name="sw0_st4_b" value="`${sw0st4_p$idx eq 0 ? black : white}`"/>
                <Substitution name="sw0_st4_st5_rl" value="`${(sw0st4_p$idx eq 1) ? ((sw0st5_p$idx eq 1) ? white : black) : ((sw0st5_p$idx eq 1) ? black : white )}`"/>
                <Substitution name="sw0_st5_t" value="`${sw0st5_p$idx eq 1 ? black : white}`"/>
                <Substitution name="sw0_st5_b" value="`${sw0st5_p$idx eq 0 ? black : white}`"/>
                <Substitution name="sw0_st5_st6_rl" value="`${(sw0st5_p$idx eq 1) ? ((sw0st6_p$idx eq 1) ? white : black) : ((sw0st6_p$idx eq 1) ? black : white )}`"/>
                <Substitution name="sw0_st6_t" value="`${sw0st6_p$idx eq 1 ? black : white}`"/>
                <Substitution name="sw0_st6_b" value="`${sw0st6_p$idx eq 0 ? black : white}`"/>
                <Substitution name="sw0_st6_st7_rl" value="`${(sw0st6_p$idx eq 1) ? ((sw0st7_p$idx eq 1) ? white : black) : ((sw0st7_p$idx eq 1) ? black : white )}`"/>
                <Substitution name="sw0_st7_t" value="`${sw0st7_p$idx eq 1 ? black : white}`"/>
                <Substitution name="sw0_st7_b" value="`${sw0st7_p$idx eq 0 ? black : white}`"/>
                <Substitution name="sw0_st7_st8_rl" value="`${(sw0st7_p$idx eq 1) ? ((sw0st8_p$idx eq 1) ? white : black) : ((sw0st8_p$idx eq 1) ? black : white )}`"/>
                <Substitution name="sw0_st8_t" value="`${sw0st8_p$idx eq 1 ? black : white}`"/>
                <Substitution name="sw0_st8_b" value="`${sw0st8_p$idx eq 0 ? black : white}`"/>
                <Substitution name="sw0_st8_st9_rl" value="`${(sw0st8_p$idx eq 1) ? ((sw0st9_p$idx eq 1) ? white : black) : ((sw0st9_p$idx eq 1) ? black : white )}`"/>
                <Substitution name="sw0_st9_t" value="`${sw0st9_p$idx eq 1 ? black : white}`"/>
