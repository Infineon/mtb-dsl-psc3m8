<PersonalityTemplate id="mxs40ppca_adc" name="ADC" version="1.0" xmlns="http://cypress.com/xsd/cyhwpersonality_v10">
  <FittingRules>
    <MappingRules>
      <IpBlock name="mxs40ppss" />
      <Resource name="ppca\.atop\.adc_grp\.adc" />
    </MappingRules>
  </FittingRules>
  <ExposedMembers>
    <ExposedMember key="channel0"  paramId="channel0" />
    <ExposedMember key="channel1"  paramId="channel1" />
    <ExposedMember key="channel2"  paramId="channel2" />
    <ExposedMember key="channel3"  paramId="channel3" />
    <ExposedMember key="channel4"  paramId="channel4" />
    <ExposedMember key="channel5"  paramId="channel5" />
    <ExposedMember key="channel6"  paramId="channel6" />
    <ExposedMember key="channel7"  paramId="channel7" />
    <ExposedMember key="eosSignal"  paramId="eosSignal" />
    <ExposedMember key="AIN0P_enabled"  paramId="AIN0P_enabled" />
    <ExposedMember key="AIN0N_enabled"  paramId="AIN0N_enabled" />
    <ExposedMember key="AIN1P_enabled"  paramId="AIN1P_enabled" />
    <ExposedMember key="AIN1N_enabled"  paramId="AIN1N_enabled" />
    <ExposedMember key="AIN2P_enabled"  paramId="AIN2P_enabled" />
    <ExposedMember key="AIN2N_enabled"  paramId="AIN2N_enabled" />
    <ExposedMember key="AIN3P_enabled"  paramId="AIN3P_enabled" />
    <ExposedMember key="AIN3N_enabled"  paramId="AIN3N_enabled" />
    <ExposedMember key="AIN4P_enabled"  paramId="AIN4P_enabled" />
    <ExposedMember key="AIN4N_enabled"  paramId="AIN4N_enabled" />
    <ExposedMember key="AIN5P_enabled"  paramId="AIN5P_enabled" />
    <ExposedMember key="AIN5N_enabled"  paramId="AIN5N_enabled" />
    <ExposedMember key="AIN6P_enabled"  paramId="AIN6P_enabled" />
    <ExposedMember key="AIN6N_enabled"  paramId="AIN6N_enabled" />
    <ExposedMember key="AIN7P_enabled"  paramId="AIN7P_enabled" />
    <ExposedMember key="AIN7N_enabled"  paramId="AIN7N_enabled" />
    <ExposedMember key="AIN8P_enabled"  paramId="AIN8P_enabled" />
    <ExposedMember key="AIN8N_enabled"  paramId="AIN8N_enabled" />
    <ExposedMember key="AIN9P_enabled"  paramId="AIN9P_enabled" />
    <ExposedMember key="AIN9N_enabled"  paramId="AIN9N_enabled" />
    <ExposedMember key="AIN10P_enabled"  paramId="AIN10P_enabled" />
    <ExposedMember key="AIN10N_enabled"  paramId="AIN10N_enabled" />
    <ExposedMember key="AIN11P_enabled"  paramId="AIN11P_enabled" />
    <ExposedMember key="AIN11N_enabled"  paramId="AIN11N_enabled" />
    <!-- AI0-AI15 exposed members for aux/alt_aux channels -->
    <ExposedMember key="altAux_AIN3N_enabled"  paramId="altAux_AIN3N_enabled" />
    <ExposedMember key="altAux_AIN11N_enabled"  paramId="altAux_AIN11N_enabled" />
    <ExposedMember key="AI0_enabled"  paramId="AI0_enabled" />
    <ExposedMember key="AI1_enabled"  paramId="AI1_enabled" />
    <ExposedMember key="AI2_enabled"  paramId="AI2_enabled" />
    <ExposedMember key="AI3_enabled"  paramId="AI3_enabled" />
    <ExposedMember key="AI4_enabled"  paramId="AI4_enabled" />
    <ExposedMember key="AI5_enabled"  paramId="AI5_enabled" />
    <ExposedMember key="AI6_enabled"  paramId="AI6_enabled" />
    <ExposedMember key="AI7_enabled"  paramId="AI7_enabled" />
    <ExposedMember key="AI8_enabled"  paramId="AI8_enabled" />
    <ExposedMember key="AI9_enabled"  paramId="AI9_enabled" />
    <ExposedMember key="AI10_enabled"  paramId="AI10_enabled" />
    <ExposedMember key="AI11_enabled"  paramId="AI11_enabled" />
    <ExposedMember key="AI12_enabled"  paramId="AI12_enabled" />
    <ExposedMember key="AI13_enabled"  paramId="AI13_enabled" />
    <ExposedMember key="AI14_enabled"  paramId="AI14_enabled" />
    <ExposedMember key="AI15_enabled"  paramId="AI15_enabled" />
    <!-- TSNS, DAC0, DAC1, AREF, VDDA_DIV2 exposed members for aux channels -->
    <ExposedMember key="TSNS_aux_enabled"  paramId="TSNS_aux_enabled" />
    <ExposedMember key="DAC0_aux_enabled"  paramId="DAC0_aux_enabled" />
    <ExposedMember key="DAC1_aux_enabled"  paramId="DAC1_aux_enabled" />
    <ExposedMember key="AREF_aux_enabled"  paramId="AREF_aux_enabled" />
    <ExposedMember key="VDDA_DIV2_GRP0_aux_enabled"  paramId="VDDA_DIV2_GRP0_aux_enabled" />
    <ExposedMember key="VDDA_DIV2_GRP1_aux_enabled"  paramId="VDDA_DIV2_GRP1_aux_enabled" />
    <!-- SOC/EOC signal display values -->
    <ExposedMember key="adc_soc0_text"  paramId="adc_soc0_text" />
    <ExposedMember key="adc_soc1_text"  paramId="adc_soc1_text" />
    <ExposedMember key="adc_soc2_text"  paramId="adc_soc2_text" />
    <ExposedMember key="adc_soc3_text"  paramId="adc_soc3_text" />
    <ExposedMember key="adc_soc4_text"  paramId="adc_soc4_text" />
    <ExposedMember key="adc_soc5_text"  paramId="adc_soc5_text" />
    <ExposedMember key="adc_soc6_text"  paramId="adc_soc6_text" />
    <ExposedMember key="adc_soc7_text"  paramId="adc_soc7_text" />
    <ExposedMember key="adc_eoc0_text"  paramId="adc_eoc0_text" />
    <ExposedMember key="adc_eoc1_text"  paramId="adc_eoc1_text" />
    <ExposedMember key="adc_eoc2_text"  paramId="adc_eoc2_text" />
    <ExposedMember key="adc_eoc3_text"  paramId="adc_eoc3_text" />
    <ExposedMember key="adc_eoc4_text"  paramId="adc_eoc4_text" />
    <ExposedMember key="adc_eoc5_text"  paramId="adc_eoc5_text" />
    <ExposedMember key="adc_eoc6_text"  paramId="adc_eoc6_text" />
    <ExposedMember key="adc_eoc7_text"  paramId="adc_eoc7_text" />
    <!-- Channel type (0=single-ended, 1=differential) exposed members -->
    <ExposedMember key="channel0type"  paramId="channel0type" />
    <ExposedMember key="channel1type"  paramId="channel1type" />
    <ExposedMember key="channel2type"  paramId="channel2type" />
    <ExposedMember key="channel3type"  paramId="channel3type" />
    <ExposedMember key="channel4type"  paramId="channel4type" />
    <ExposedMember key="channel5type"  paramId="channel5type" />
    <ExposedMember key="channel6type"  paramId="channel6type" />
    <ExposedMember key="channel7type"  paramId="channel7type" />
    <!-- Channel sequence string for SVG display -->
    <ExposedMember key="channelSeqText"  paramId="channelSeqText" />
    <ExposedMember key="auxSeqText"  paramId="auxSeqText" />
    <ExposedMember key="altAuxSeqText"  paramId="altAuxSeqText" />
    <!-- AUX / ALT AUX slot counts for SVG fill logic -->
    <ExposedMember key="noOfAuxSlots"  paramId="noOfAuxSlots" />
    <ExposedMember key="noOfAltAuxSlots"  paramId="noOfAltAuxSlots" />
  </ExposedMembers>

  <Parameters>

    <!-- PDL documentation -->
    <ParamDoc id="pdlDoc" name="Configuration Help" group="Overview" default="file:///`${cy_libs_path()}`/docs/html/group__group__ppca__adc.html" linkText="Open PPCA ADC Documentation" visible="true" desc="Opens the Peripheral Driver Library Documentation" />
    <ParamString id="adcGroupNumber" name="ADC Group Number" group="Internal" default="`${getInstNumber(&quot;adc_grp&quot;)}`" visible="false" editable="false" desc="ADC Group name number." />

    <!-- ADC Conversion Configuration -->
    <ParamBool id="calibGainMode" name="Calibration Mode" group="ADC Conversion Configuration" default="false" visible="false" editable="false" desc="if enabled, IP handles calibration and gain computation, else subsystem has to handle. "/>
    <ParamBool id="auxSlotSelect" name="AUX Channel Slot Control" group="ADC Conversion Configuration" default="false" visible="`${(adcGroupNumber eq 0)}`" editable="`${(adcGroupNumber eq 0)}`" desc="if enabled,Slot Control scheme for the AUX Channel is enabled, else disabled. "/>
    <ParamBool id="altAuxSlotSelect" name="ALTAUX Channel Slot Control" group="ADC Conversion Configuration" default="false" visible="`${((adcGroupNumber eq 0) || (adcGroupNumber eq 3))}`" editable="`${((adcGroupNumber eq 0) || (adcGroupNumber eq 3))}`" desc="if enabled,Slot Control scheme for the ALT AUX Channel is enabled, else disabled. "/>


    <ParamBool id="groupOfChannels" name="Grouping Of Channels" group="ADC Conversion Configuration" default="false" visible="true" editable="true" desc="Enable Group of Sequence of Channels to be converted at provided trigger. "/>
    <ParamChoice id="triggerMode"
                 name="Trigger Mode"
                 group="ADC Conversion Configuration"
                 visible="true"
                 editable="true"
                 desc="Trigger Mode Selection. Manual, Continuous Conversion and Arbitrary Conversion."
                 default="CY_ADC_MANUAL_TRIGGER">
      <Entry name="Manual Trigger Mode" value="CY_ADC_MANUAL_TRIGGER" visible="true"/>
      <Entry name="Auto Trigger Mode" value="CY_ADC_AUTO_TRIGGER" visible="true"/>
      <Entry name="Arbitrary Trigger Mode" value="CY_ADC_ARBITRARY_TRIGGER" visible="true"/>
    </ParamChoice>
    <ParamRange id="samplingCycles" name="Sampling Cycles" group="ADC Conversion Configuration" default="0" min="0" max="63" resolution="1" visible="true" editable="true" desc="Number of system clock cycles for sampling on top of a minimum of 4 clock cycles. This is not applicable for Arbitary trigger mode. When AFE is used, AFE_CLOCK_RATIO will define the sample period." />
    <ParamBool id="eosSignal" name="Source of EOS" group="ADC Conversion Configuration" default="false" visible="true" editable="true" desc="If enabled ADC conversion is started with SOC signal. If disabled ADC conversion is started with trigger."/>

    <!-- ADC Channel Configuration -->

    <ParamString id="ch0_input" name="Channel0 Input" group="Internal" default="`${((adcGroupNumber eq 0) ? &quot;AIN0P&quot; : ((adcGroupNumber eq 1) ? &quot;AIN4P&quot; : ((adcGroupNumber eq 2) ? &quot;AIN6P&quot; : &quot;AIN8P&quot;)))}`" visible="false" editable="false" desc="ADC CHannel 0 input." />
    <ParamString id="ch1_input" name="Channel1 Input" group="Internal" default="`${((adcGroupNumber eq 0) ? &quot;AIN0N&quot; : ((adcGroupNumber eq 1) ? &quot;AIN4N&quot; : ((adcGroupNumber eq 2) ? &quot;AIN6N&quot; : &quot;AIN8N&quot;)))}`" visible="false" editable="false" desc="ADC CHannel 1 input." />
    <ParamString id="ch2_input" name="Channel2 Input" group="Internal" default="`${((adcGroupNumber eq 0) ? &quot;AIN1P&quot; : ((adcGroupNumber eq 1) ? &quot;AIN5P&quot; : ((adcGroupNumber eq 2) ? &quot;AIN7P&quot; : &quot;AIN9P&quot;)))}`" visible="false" editable="false" desc="ADC CHannel 2 input." />
    <ParamString id="ch3_input" name="Channel3 Input" group="Internal" default="`${((adcGroupNumber eq 0) ? &quot;AIN1N&quot; : ((adcGroupNumber eq 1) ? &quot;AIN5N&quot; : ((adcGroupNumber eq 2) ? &quot;AIN7N&quot; : &quot;AIN9N&quot;)))}`" visible="false" editable="false" desc="ADC CHannel 3 input." />
    <ParamString id="ch4_input" name="Channel4 Input" group="Internal" default="`${((adcGroupNumber eq 0) ? &quot;AIN2P&quot; : &quot;AIN10P&quot;)}`" visible="false" editable="false" desc="ADC CHannel 4 input." />
    <ParamString id="ch5_input" name="Channel5 Input" group="Internal" default="`${((adcGroupNumber eq 0) ? &quot;AIN2N&quot; : &quot;AIN10N&quot;)}`" visible="false" editable="false" desc="ADC CHannel 5 input." />
    <ParamString id="ch6_input" name="Channel6 Input" group="Internal" default="`${((adcGroupNumber eq 0) ? &quot;AIN3P&quot; : &quot;AIN11P&quot;)}`" visible="false" editable="false" desc="ADC CHannel 6 input." />
    <ParamString id="ch7_input" name="Channel7 Input" group="Internal" default="`${((adcGroupNumber eq 0) ? &quot;AIN3N&quot; : &quot;AIN11N&quot;)}`" visible="false" editable="false" desc="ADC CHannel 7 input." />

    <Repeat count="8">
        <ParamString id="channel$idx_modular" name="Channel Modular $idx" group="ADC Channel Configuration" default="`${($idx) % 2}`" visible="false" editable="false" desc="ADC Group name number."/>
        <ParamString id="channelPair$idx" name="Channel Pair $idx" group="ADC Channel Configuration" default="`${((channel$idx_modular eq 0) ? 1 : -1)}`" visible="false" editable="false" desc="ADC Group name number."/>

        <ParamBool id="channel$idx" name="Channel $idx / `${ch$idx_input}`" group="ADC Channel Configuration" default="false" visible="`${($idx &gt; 3) ? ((adcGroupNumber eq 0) || (adcGroupNumber eq 3) ? true : false) : true}`" editable="true" desc="if enabled, Channel $idx is enabled "/>


        <ParamChoice id="channel$idxtype"
                     name="Channel $idx Type"
                     group="ADC Channel Configuration"
                     visible="`${channel$idx}`"
                     editable="`${channel$idx}`"
                     desc="Single Ended Channel or Differential Channel. (0,1), (2,3), (4,5) and (6,7) are the 4 differential pairs based on the ADC group and number of channles available."
                     default="`${(channel$idx_modular eq 0) ? 0 : getParamValue(&quot;channel&quot; . ($idx-1) . &quot;type&quot;)}`">
          <Entry name="Single Ended" value="0" visible="`${(channel$idx_modular eq 0) ? true : ((getParamValue(&quot;channel&quot; . ($idx+channelPair$idx) . &quot;type&quot;) eq 0) ? true : false)}`"/>
          <Entry name="Differential" value="1" visible="true"/>
        </ParamChoice>
        <ParamString id="channel$idx_visibility" name="Channel $idx visibility" group="ADC Channel Configuration" default="`${(channel$idxtype eq 0) ? true : (channel$idx_modular eq 0) ? true : false}`" visible="false" editable="false" desc="Internally used for visibility of the channel"/>
        <ParamChoice id="channel$idxDataType"
                     name="Channel $idx Data Type"
                     group="ADC Channel Configuration"
                     visible="`${(channel$idx) &amp;&amp; (channel$idx_visibility)}`"
                     editable="`${(channel$idx) &amp;&amp; (channel$idx_visibility)}`"
                     desc="Signed or Unsigned ADC channel"
                     default="0">
          <Entry name="Unsigned" value="0" visible="true"/>
          <Entry name="Signed" value="1" visible="true"/>
        </ParamChoice>
    </Repeat>

    <!-- AIN Pin enable status for parent personality access -->
    <!-- ADC Group 0 (8 channels): AIN0P/N to AIN3P/N -->
    <ParamBool id="AIN0P_enabled" name="AIN0P Enabled" group="Internal" default="`${(adcGroupNumber eq 0) ? channel0 : false}`" visible="false" editable="false" desc="AIN0P enable status" />
    <ParamBool id="AIN0N_enabled" name="AIN0N Enabled" group="Internal" default="`${(adcGroupNumber eq 0) ? channel1 : false}`" visible="false" editable="false" desc="AIN0N enable status" />
    <ParamBool id="AIN1P_enabled" name="AIN1P Enabled" group="Internal" default="`${(adcGroupNumber eq 0) ? channel2 : false}`" visible="false" editable="false" desc="AIN1P enable status" />
    <ParamBool id="AIN1N_enabled" name="AIN1N Enabled" group="Internal" default="`${(adcGroupNumber eq 0) ? channel3 : false}`" visible="false" editable="false" desc="AIN1N enable status" />
    <ParamBool id="AIN2P_enabled" name="AIN2P Enabled" group="Internal" default="`${(adcGroupNumber eq 0) ? channel4 : false}`" visible="false" editable="false" desc="AIN2P enable status" />
    <ParamBool id="AIN2N_enabled" name="AIN2N Enabled" group="Internal" default="`${(adcGroupNumber eq 0) ? channel5 : false}`" visible="false" editable="false" desc="AIN2N enable status" />
    <ParamBool id="AIN3P_enabled" name="AIN3P Enabled" group="Internal" default="`${(adcGroupNumber eq 0) ? channel6 : false}`" visible="false" editable="false" desc="AIN3P enable status" />
    <ParamBool id="AIN3N_enabled" name="AIN3N Enabled" group="Internal" default="`${(adcGroupNumber eq 0) ? channel7 : false}`" visible="false" editable="false" desc="AIN3N enable status" />

    <!-- ADC Group 1 (4 channels): AIN4P/N to AIN5P/N -->
    <ParamBool id="AIN4P_enabled" name="AIN4P Enabled" group="Internal" default="`${(adcGroupNumber eq 1) ? channel0 : false}`" visible="false" editable="false" desc="AIN4P enable status" />
    <ParamBool id="AIN4N_enabled" name="AIN4N Enabled" group="Internal" default="`${(adcGroupNumber eq 1) ? channel1 : false}`" visible="false" editable="false" desc="AIN4N enable status" />
    <ParamBool id="AIN5P_enabled" name="AIN5P Enabled" group="Internal" default="`${(adcGroupNumber eq 1) ? channel2 : false}`" visible="false" editable="false" desc="AIN5P enable status" />
    <ParamBool id="AIN5N_enabled" name="AIN5N Enabled" group="Internal" default="`${(adcGroupNumber eq 1) ? channel3 : false}`" visible="false" editable="false" desc="AIN5N enable status" />

    <!-- ADC Group 2 (4 channels): AIN6P/N to AIN7P/N -->
    <ParamBool id="AIN6P_enabled" name="AIN6P Enabled" group="Internal" default="`${(adcGroupNumber eq 2) ? channel0 : false}`" visible="false" editable="false" desc="AIN6P enable status" />
    <ParamBool id="AIN6N_enabled" name="AIN6N Enabled" group="Internal" default="`${(adcGroupNumber eq 2) ? channel1 : false}`" visible="false" editable="false" desc="AIN6N enable status" />
    <ParamBool id="AIN7P_enabled" name="AIN7P Enabled" group="Internal" default="`${(adcGroupNumber eq 2) ? channel2 : false}`" visible="false" editable="false" desc="AIN7P enable status" />
    <ParamBool id="AIN7N_enabled" name="AIN7N Enabled" group="Internal" default="`${(adcGroupNumber eq 2) ? channel3 : false}`" visible="false" editable="false" desc="AIN7N enable status" />

    <!-- ADC Group 3 (8 channels): AIN8P/N to AIN11P/N -->
    <ParamBool id="AIN8P_enabled" name="AIN8P Enabled" group="Internal" default="`${(adcGroupNumber eq 3) ? channel0 : false}`" visible="false" editable="false" desc="AIN8P enable status" />
    <ParamBool id="AIN8N_enabled" name="AIN8N Enabled" group="Internal" default="`${(adcGroupNumber eq 3) ? channel1 : false}`" visible="false" editable="false" desc="AIN8N enable status" />
    <ParamBool id="AIN9P_enabled" name="AIN9P Enabled" group="Internal" default="`${(adcGroupNumber eq 3) ? channel2 : false}`" visible="false" editable="false" desc="AIN9P enable status" />
    <ParamBool id="AIN9N_enabled" name="AIN9N Enabled" group="Internal" default="`${(adcGroupNumber eq 3) ? channel3 : false}`" visible="false" editable="false" desc="AIN9N enable status" />
    <ParamBool id="AIN10P_enabled" name="AIN10P Enabled" group="Internal" default="`${(adcGroupNumber eq 3) ? channel4 : false}`" visible="false" editable="false" desc="AIN10P enable status" />
    <ParamBool id="AIN10N_enabled" name="AIN10N Enabled" group="Internal" default="`${(adcGroupNumber eq 3) ? channel5 : false}`" visible="false" editable="false" desc="AIN10N enable status" />
    <ParamBool id="AIN11P_enabled" name="AIN11P Enabled" group="Internal" default="`${(adcGroupNumber eq 3) ? channel6 : false}`" visible="false" editable="false" desc="AIN11P enable status" />
    <ParamBool id="AIN11N_enabled" name="AIN11N Enabled" group="Internal" default="`${(adcGroupNumber eq 3) ? channel7 : false}`" visible="false" editable="false" desc="AIN11N enable status" />

    <ParamString id="diffChEnabled" name="No Of Diiferential Channels Enabled" group="Internal" default="`${channel0type + channel2type + channel4type + channel6type}`" visible="false" editable="false" desc="ADC number of differential channels enabled." />
    <ParamString id="channelsEnabled" name="No Of Channels Enabled" group="Internal" default="`${channel0 + channel1 + channel2 + channel3 + channel4 + channel5 + channel6 + channel7}`" visible="false" editable="false" desc="ADC number of channels enabled." />
    <ParamRange id="noOfSlots" name="No Of Channels To Be Converted" group="ADC Channel Configuration" default="0" min="0" max="`${((adcGroupNumber eq 0) || (adcGroupNumber eq 3) ? 8 : 4)}`" resolution="1" visible="true" editable="true" desc="Number of channels to be converted during the slot operation. One differential channels is considered as 2 channels" />

    <ParamRange id="noOfAuxSlots" name="No Of AUX Channels To Be Converted" group="Auxiliary Channel Configuration" default="0" min="0" max="8" resolution="1" visible="`${(adcGroupNumber eq 0)}`" editable="`${(adcGroupNumber eq 0)}`" desc="Number of Aux channels to be converted during the slot operation. Channel 7 must be enabled for Auxiliary channels." />
    <ParamRange id="noOfAltAuxSlots" name="No Of ALT AUX Channels To Be Converted" group="ALT Auxiliary Channel Configuration" default="0" min="0" max="8" resolution="1" visible="`${((adcGroupNumber eq 0) || (adcGroupNumber eq 3))}`" editable="`${((adcGroupNumber eq 0) || (adcGroupNumber eq 3))}`" desc="Number of ALT AUX channels to be converted during the slot operation. Channel 7 must be enabled for ALT Auxiliary channels" />

    <Repeat count="9">
        <ParamChoice id="channel$idxSeq"
             name="Channel to be Converted at Position $idx"
             group="ADC Channel Configuration"
             visible="`${($idx &gt; 0)&amp;&amp; ($idx &lt;= noOfSlots) &amp;&amp; (noOfSlots &gt; 0)}`"
             editable="`${($idx &gt; 0)&amp;&amp; ($idx &lt;= noOfSlots) &amp;&amp; (noOfSlots &gt; 0)}`"
             desc="Sequence in which the channels to be converted. When differential channels are enabled, make sure they are placed consecutively."
             default="15">
          <Entry name="Assign the position" value="15" visible="true"/>
          <Entry name="Channel 0" value="1" visible="`${((channel0 eq true) ? true : false)}`"/>
          <Entry name="Channel 1" value="2" visible="`${((channel1 eq true) ? true : false)}`"/>
          <Entry name="Channel 2" value="3" visible="`${((channel2 eq true) ? true : false)}`"/>
          <Entry name="Channel 3" value="4" visible="`${((channel3 eq true) ? true : false)}`"/>
          <Entry name="Channel 4" value="5" visible="`${((((adcGroupNumber eq 0) || (adcGroupNumber eq 3)) &amp;&amp; (channel4 eq true)) ? true : false)}`"/>
          <Entry name="Channel 5" value="6" visible="`${((((adcGroupNumber eq 0) || (adcGroupNumber eq 3)) &amp;&amp; (channel5 eq true)) ? true : false)}`"/>
          <Entry name="Channel 6" value="7" visible="`${((((adcGroupNumber eq 0) || (adcGroupNumber eq 3)) &amp;&amp; (channel6 eq true)) ? true : false)}`"/>
          <Entry name="Channel 7" value="8" visible="`${((((adcGroupNumber eq 0) || (adcGroupNumber eq 3)) &amp;&amp; (channel7 eq true)) ? true : false)}`"/>
        </ParamChoice>

        <ParamString id="ch$idxSeq" name="Actual Sequence" group="ADC Channel Configuration" default="`${(((channel$idxSeq eq 0) || (channel$idxSeq eq 15)) ? 15 : ((getParamValue(&quot;channel&quot; . ($idx) . &quot;Seq&quot;)) -1))}`" visible="false" editable="false" desc="ADC number of differential channels enabled." />
    <!--ParamSignal port="adc_eoc[$idx]" name="adc_eoc[$idx]" visible="`${((hasVisibleOption(&quot;adc_eoc[$idx]&quot;)) &amp;&amp; (($idx &gt; 0) &amp;&amp; (channelsEnabled &gt;= $idx)))}`" canBeEmpty="true" group="Signals" desc="" /-->
    <!-- <ParamSignal port="adc_eoc[$idx]" name="adc_eoc[$idx]" visible="`${(($idx &gt; 0) &amp;&amp; (channelsEnabled &gt;= $idx))}`" canBeEmpty="true" group="Signals" desc="" /> -->
    </Repeat>
    <ParamString id="chSeqValue" name="chSeqValue" group="ADC Channel Configuration" default="`${ch1Seq | (ch2Seq &lt;&lt; 4) | (ch3Seq &lt;&lt; 8) | (ch4Seq &lt;&lt; 12) | (ch5Seq &lt;&lt; 16) | (ch6Seq &lt;&lt; 20) | (ch7Seq &lt;&lt; 24) | (ch8Seq &lt;&lt; 28)}`" visible="false" editable="false" desc="ADC number of differential channels enabled." />
    <!-- Human-readable channel sequence string (e.g., "0, 2, 3, 5") -->
