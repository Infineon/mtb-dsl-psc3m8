    <ParamString id="out_14" name="" default='CY_COMBO_PUT2_OUT14_QUAL' desc="" group="" visible="false" editable="false"/>
    <ParamString id="out_15" name="" default='CY_COMBO_PUT2_OUT15_QUAL' desc="" group="" visible="false" editable="false"/>

    <ParamString id="inQual" name="Input Qualifier" default='`${((qix eq 28) ) ? out_28 : (((qix eq 29)) ? out_29 : (((qix eq 30)) ? out_30 : (((qix eq 31)) ? out_31 : (((qix eq 12)) ? out_12 : (((qix eq 13)) ? out_13 : (((qix eq 14)) ? out_14 : (((qix eq 15)) ? out_15 : NULL_QUAL)))))))}`' desc="Input Signals from PUT1_OUT[0-15]" group="" visible="false" editable="false"/>

    <ParamString id="qualInText" name="qualInText" group="Internal" default="`${hasConnection(&quot;pu_in_qualifier&quot;, 0) ? ((inQual eq out_28) ? &quot;PUT1_OUT28&quot; : ((inQual eq out_29) ? &quot;PUT1_OUT29&quot; : ((inQual eq out_30) ? &quot;PUT1_OUT30&quot; : ((inQual eq out_31) ? &quot;PUT1_OUT31&quot; : ((inQual eq out_12) ? &quot;PUT2_OUT12&quot; : ((inQual eq out_13) ? &quot;PUT2_OUT13&quot; : ((inQual eq out_14) ? &quot;PUT2_OUT14&quot; : ((inQual eq out_15) ? &quot;PUT2_OUT15&quot; : &quot;PU_IN_QUAL&quot;)))))))) : &quot;PU_IN_QUAL&quot;}`" visible="false" editable="false" desc="" />

    <ParamBool id="enableQual" name="Enable Qualifier" group="COMBO Configuration/Qualifier" default="false" visible="true" editable="true" desc="This parameter enables/disables Qualifier "/>
    <ParamString id="qualInLineColor" name="qualInLineColor" group="Internal" default="`${(enableQual) ? greenLine : defaultLine}`" visible="false" editable="false" desc="" />
    <ParamString id="qualInBlockColor" name="qualInBlockColor" group="Internal" default="`${(enableQual) ? greenBlock : defaultBlock}`" visible="false" editable="false" desc="" />
    <ParamString id="qualInTextColor" name="qualInTextColor" group="Internal" default="`${(enableQual) ? greenText : defaultLine}`" visible="false" editable="false" desc="" />

    <ParamBool id="enablePolInv" name="Enable Polarity Inversion" group="COMBO Configuration" default="false" visible="true" editable="true" desc="This parameter enables/disables Polarity Inversion "/>
    <ParamString id="polInvLineColor" name="polInvLineColor" group="Internal" default="`${(enablePolInv) ? greenLine : defaultLine}`" visible="false" editable="false" desc="" />
    <ParamString id="polInvBlockColor" name="polInvBlockColor" group="Internal" default="`${(enablePolInv) ? greenBlock : defaultBlock}`" visible="false" editable="false" desc="" />
    <ParamString id="polInvTextColor" name="polInvTextColor" group="Internal" default="`${(enablePolInv) ? greenText : defaultLine}`" visible="false" editable="false" desc="" />

    <ParamString id="comboEnLineColor" name="comboEnLineColor" group="Internal" default="`${((srcInEnable ne CY_COMBO_DISABLE_INPUT_SIGNAL_A_AND_B) || (put1InEnable ne CY_COMBO_DISABLE_INPUT_SIGNAL_A_AND_B)) ? greenLine : defaultLine}`" visible="false" editable="false" desc="" />
    <ParamString id="comboEnBlockColor" name="comboEnBlockColor" group="Internal" default="`${((srcInEnable ne CY_COMBO_DISABLE_INPUT_SIGNAL_A_AND_B) || (put1InEnable ne CY_COMBO_DISABLE_INPUT_SIGNAL_A_AND_B)) ? greenBlock : defaultBlock}`" visible="false" editable="false" desc="" />
    <ParamString id="comboEnTextColor" name="comboEnTextColor" group="Internal" default="`${((srcInEnable ne CY_COMBO_DISABLE_INPUT_SIGNAL_A_AND_B) || (put1InEnable ne CY_COMBO_DISABLE_INPUT_SIGNAL_A_AND_B)) ? greenText : defaultLine}`" visible="false" editable="false" desc="" />

    <ParamString id="instNumber" name="Instance number" group="Internal" default="`${getInstNumber(&quot;combiner&quot;)}`" visible="false" editable="false" desc="EPUTY1 Instance name number." />
    <ParamString id="combinerRsc" name="Combiner Resource" group="Internal" default="`${&quot;ppca[0].epu[0].combiner[&quot; . instNumber . &quot;]&quot;}`" visible="false" editable="false" desc="" />

    <ParamSignal port="event_out[0]" name="event_out" group="Signals" visible="`${hasVisibleOption(&quot;event_out[0]&quot;)}`" desc="" canBeEmpty="true" />
    <ParamBool id="requiresEventOut" name="requiresEventOut" group="Internal" default="`${hasConnection(&quot;event_out&quot;, 0)}`" visible="false" editable="true" desc="Latches true once event_out is connected, so a later disconnect can still be detected." />

    <ParamImage id="combo"
                name="COMBINER"
                group="COMBO Configuration"
                desc=""
                visible="true"
                position="OUTSET"
                default="`${cy_libs_path()}`/device-info/personalities/ppca/EPU_COMBO.svg">
    <Substitution name="bankSel_lineColor" value="`${bankSelLineColor}`"/>
    <Substitution name="bankSel_blockColor" value="`${bankSelBlockColor}`"/>
    <Substitution name="bankSelSigA_lineColor" value="`${bankSelSigALineColor}`"/>
    <Substitution name="bankSelSigB_lineColor" value="`${bankSelSigBLineColor}`"/>
    <Substitution name="bankSelSigA_textColor" value="`${bankSelSigATextColor}`"/>
    <Substitution name="bankSelSigB_textColor" value="`${bankSelSigBTextColor}`"/>
    <Substitution name="puSrcIn_lineColor" value="`${puSrcInLineColor}`"/>
    <Substitution name="puSrcIn_blockColor" value="`${puSrcInBlockColor}`"/>
    <Substitution name="srcInSigC_lineColor" value="`${srcInSigCLineColor}`"/>
    <Substitution name="srcInSigD_lineColor" value="`${srcInSigDLineColor}`"/>
    <Substitution name="srcInSigC_textColor" value="`${srcInSigCTextColor}`"/>
    <Substitution name="srcInSigD_textColor" value="`${srcInSigDTextColor}`"/>
    <Substitution name="qualIn_lineColor" value="`${qualInLineColor}`"/>
    <Substitution name="qualIn_blockColor" value="`${qualInBlockColor}`"/>
    <Substitution name="qualIn_textColor" value="`${qualInTextColor}`"/>
    <Substitution name="polInv_lineColor" value="`${polInvLineColor}`"/>
    <Substitution name="polInv_blockColor" value="`${polInvBlockColor}`"/>
    <Substitution name="polInv_textColor" value="`${polInvTextColor}`"/>
    <Substitution name="comboEn_lineColor" value="`${comboEnLineColor}`"/>
    <Substitution name="comboEn_blockColor" value="`${comboEnBlockColor}`"/>
    <Substitution name="comboEn_textColor" value="`${comboEnTextColor}`"/>
    <Substitution name="bankSelSigA_text" value="`${bankSelSigAText}`"/>
    <Substitution name="bankSelSigB_text" value="`${bankSelSigBText}`"/>
    <Substitution name="srcInSigC_Text" value="`${srcInSigCText}`"/>
    <Substitution name="srcInSigD_Text" value="`${srcInSigDText}`"/>
    <Substitution name="qualIn_Text" value="`${qualInText}`"/>

    </ParamImage>

    <ParamString id="epuRsc" name="epuRsc" group="Internal" default="`${&quot;ppca[0].epu[0]&quot;}`" visible="false" editable="false" desc="" />
    <ParamString id="epuUsed" name="epuUsed" group="Internal" default="`${isBlockUsed(epuRsc)}`" visible="false" editable="false" desc="" />

    <ParamBool id="init" name="Initialize During Startup" group="Advanced" default="true" visible="true" editable="true" desc="Performs an automatic initialization in the init_cycfg_peripherals() generated function." />
    <ParamBool id="inFlash" name="Store Config in Flash" group="Advanced" default="true" visible="true" editable="true" desc="Controls whether the configuration structure is stored in flash (const, true) or SRAM (not const, false)." />
  </Parameters>

  <DRCs>
      <DRC type="ERROR" text="Enable EPU." condition="`${!epuUsed}`">
        <FixIt action="ENABLE_BLOCK" target="`${epuRsc}`" value="mxs40ppca-epu-1.0" valid="true" />
      </DRC>
      <DRC type="ERROR" text="Invalid Bank Select combination. If Signal A = PU T1[`${aix}`], then Signal B should be PU T1[`${bix_exp}`]. If Signal B = PU T1[`${bix}`], then Signal A should be PU T1[`${aix_exp}`]. Change either Signal A or Signal B." condition='`${getParamValue("signal_a[0]") ne "" &amp;&amp; getParamValue("signal_b[0]") ne "" &amp;&amp; getParamValue("signal_b[0]") ne signal_b_sig}`'>
        <FixIt action='SET_PARAM' target='signal_b[0]' value='`${signal_b_sig}`' valid='true' />
        <FixIt action='SET_PARAM' target='signal_a[0]' value='`${signal_a_sig}`' valid='true' />
      </DRC>
      <DRC type="ERROR" text="Invalid Processing Unit Input Source Select combination. If Signal C = PU T1[`${cix}`], Signal D should be PU T2[`${dix_exp}`]. If Signal D = PU T2[`${dix}`], Signal C should be PU T1[`${cix_exp}`]. Change either Signal C or Signal D." condition='`${getParamValue("signal_c[0]") ne "" &amp;&amp; getParamValue("signal_d[0]") ne "" &amp;&amp; getParamValue("signal_d[0]") ne signal_d_sig}`'>
        <FixIt action='SET_PARAM' target='signal_c[0]' value='`${signal_c_sig}`' valid='true' />
        <FixIt action='SET_PARAM' target='signal_d[0]' value='`${signal_d_sig}`' valid='true' />
      </DRC>
      <DRC type="INFO" text="Signal A is enabled but has no connection." condition="`${!hasConnection(&quot;signal_a&quot;, 0) &amp;&amp; (put1InEnable eq CY_COMBO_ENABLE_INPUT_SIGNAL_A)}`" paramId="put1InEnable" />
      <DRC type="INFO" text="Signal B is enabled but has no connection." condition="`${!hasConnection(&quot;signal_b&quot;, 0) &amp;&amp; (put1InEnable eq CY_COMBO_ENABLE_INPUT_SIGNAL_B)}`" paramId="put1InEnable" />
      <DRC type="INFO" text="Both Signal A and B should have connections." condition="`${(!hasConnection(&quot;signal_b&quot;, 0) || !hasConnection(&quot;signal_a&quot;, 0)) &amp;&amp; (put1InEnable eq CY_COMBO_ENABLE_INPUT_SIGNAL_A_AND_B)}`" paramId="put1InEnable" />

      <DRC type="INFO" text="Signal C is enabled but has no connection." condition="`${!hasConnection(&quot;signal_c&quot;, 0) &amp;&amp; (srcInEnable eq CY_COMBO_ENABLE_INPUT_SIGNAL_A)}`" paramId="srcInEnable" />
      <DRC type="INFO" text="Signal D is enabled but has no connection." condition="`${!hasConnection(&quot;signal_d&quot;, 0) &amp;&amp; (srcInEnable eq CY_COMBO_ENABLE_INPUT_SIGNAL_B)}`" paramId="srcInEnable" />
      <DRC type="INFO" text="Both Signal C and D should have connections." condition="`${(!hasConnection(&quot;signal_c&quot;, 0) || !hasConnection(&quot;signal_d&quot;, 0)) &amp;&amp; (srcInEnable eq CY_COMBO_ENABLE_INPUT_SIGNAL_A_AND_B)}`" paramId="srcInEnable" />

      <DRC type="INFO" text="Combiner should have at least one input signal." condition="`${(put1InEnable eq CY_COMBO_DISABLE_INPUT_SIGNAL_A_AND_B) &amp;&amp; (srcInEnable eq CY_COMBO_DISABLE_INPUT_SIGNAL_A_AND_B)}`" paramId="srcSignal" />

      <DRC type="ERROR" text="Event signal became unassigned." condition="`${isBlockUsed(combinerRsc) &amp;&amp; requiresEventOut &amp;&amp; !hasConnection(&quot;event_out&quot;, 0)}`">
        <FixIt action="DISABLE_BLOCK" target="`${combinerRsc}`" valid="true" />
      </DRC>

      <DRC type="INFO" text="Qualifier is enabled but has no connection." condition="`${!hasConnection(&quot;pu_in_qualifier&quot;, 0) &amp;&amp; enableQual}`" paramId="enableQual" />

  </DRCs>

  <ConfigFirmware>
      <ConfigInclude value="cy_ppca_epu.h" include="true" />
      <ConfigDefine name="`${INST_NAME}`_INDEX" value="`${instNumber}`" public="true" include="true" />
      <ConfigDefine name="`${INST_NAME}`_HW" value="PPCA_EPU_EPU" public="true" include="true" />
      <ConfigStruct name="`${INST_NAME}`_combo_config" type="cy_stc_ppca_epu_combo_config_t" const="`${inFlash}`"  public="true" include="true" >
      <Member name="bankSel" value="`${bankSel}`" />
      <Member name="put1InEnable" value="`${put1InEnable}`" />
      <Member name="puSrcIn" value="`${puSrcIn}`" />
      <Member name="srcInEnable" value="`${srcInEnable}`" />
      <Member name="inQual" value="`${inQual}`" />
      <Member name="enableQual" value="`${enableQual}`" />
      <Member name="enablePolInv" value="`${enablePolInv}`" />
    </ConfigStruct>

    <ConfigInstruction value="Cy_PPCA_EPU_Combo_Configure(`${INST_NAME}`_HW, `${INST_NAME}`_INDEX, &amp;`${INST_NAME}`_combo_config);" include="`${init}`" purpose="INITIALIZE" />

  </ConfigFirmware>

